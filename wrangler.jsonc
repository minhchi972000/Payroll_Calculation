{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bang-luong",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bang-luong",
      "database_id": "f8854032-c4f6-41de-9b68-e7776ae3a3dc",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  // Bản demo: web riêng (bang-luong-demo) và database riêng, dữ liệu giả để thử.
  // Deploy bằng: npm run deploy:demo
  "env": {
    "demo": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "bang-luong-demo",
          "database_id": "5a2ebb36-6029-4af2-b69a-bfcff2a132de",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
