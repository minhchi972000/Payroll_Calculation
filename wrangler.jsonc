{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bang-luong",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bang-luong",
      "database_id": "f8854032-c4f6-41de-9b68-e7776ae3a3dc",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
